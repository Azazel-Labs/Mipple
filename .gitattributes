# Text files are stored and checked out with LF on every platform, overriding core.autocrlf
# (Git for Windows defaults it to true).
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.dds binary
*.ktx2 binary
*.zip binary
*.pdf binary
